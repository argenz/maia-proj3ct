# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gmail OAuth Refresh Token (generated by scripts/oauth_setup.py)
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# Gmail OAuth Client ID and Secret (from Google Cloud Console)
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here

# Gmail Accounts
GMAIL_NEWSLETTER_ACCOUNT=your_newsletter_account@gmail.com

# Digest recipients (comma-separated for multiple)
# Option 1: Single recipient (backwards compatible)
GMAIL_DIGEST_RECIPIENT=your_main_email@gmail.com
# Option 2: Multiple recipients (takes precedence if set)
# GMAIL_DIGEST_RECIPIENTS=email1@gmail.com,email2@gmail.com
